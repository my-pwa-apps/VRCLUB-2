# Security headers for static hosts (Cloudflare Pages, Netlify).
#
# scripts/serve.mjs sends these itself, but the README recommends deploying dist/
# to static hosting - where nothing sends frame-ancestors or X-Frame-Options at
# all, leaving a WebXR app clickjackable. This file closes that gap; the meta CSP
# in index.html cannot, because browsers ignore frame-ancestors in a <meta> tag.

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Content-hashed bundles are immutable by construction.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Worker scripts must never be pinned: updateViaCache defaults to 'imports', so a
# long max-age here makes service-worker updates impossible to ship.
/sw.js
  Cache-Control: no-cache
/serviceworker.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# The web app manifest keeps a stable name, so it revalidates; the spec's media type is manifest+json.
/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/icons/*
  Cache-Control: no-cache
/screenshots/*
  Cache-Control: no-cache
# The phone page that pairs a headset: plain, unhashed files.
/link/*
  Cache-Control: no-cache
# The club's own default set: a stable name that is regenerated in place, so it revalidates (a 304 costs nothing).
/audio/*
  Cache-Control: no-cache

# Dependencies
node_modules/
# NOTE: package-lock.json is intentionally NOT ignored. Committing the lockfile is
# what makes `npm ci` reproducible across machines and CI; ignoring it meant every
# install could silently resolve different transitive versions.
yarn.lock


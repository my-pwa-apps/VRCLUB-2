{
  "name": "vrclub",
  "version": "1.1.0",
  "cacheToken": "20261006-6",
  "description": "Hyperrealistic Babylon.js WebXR VR Club with music streaming for Meta Quest 3S",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "start:prod": "npm run build && node scripts/serve.mjs --dist",
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-syntax.mjs",
    "lint": "eslint .",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check:sri": "node scripts/check-sri.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "vendor:babylon": "node scripts/fetch-vendor.mjs",
    "optimize:avatars": "node scripts/optimize-avatars.mjs",
    "optimize:models": "node scripts/optimize-models.mjs"
  },
  "keywords": [
    "webxr",
    "vr",
    "quest",
    "music",
    "club",
    "nightclub",
    "virtual-reality"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/my-pwa-apps/VRCLUB-2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "iwer": "^2.5.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
